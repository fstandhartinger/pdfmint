# Copy to .env.local. Only the first two are needed to start.

# Postgres. Any Postgres will do; production runs on a Neon free-tier database.
DATABASE_URL=postgresql://user:password@localhost:5432/pdfmint

# Signs the dashboard session cookie. Any long random string.
SESSION_SECRET=

# The URL this deployment is reachable at. It is what canonical tags, hosted-file
# links and Stripe redirects are built from, and requests arriving on any other
# hostname are 301'd here. Leave it empty locally.
PUBLIC_URL=
PORT=3000

# Set to production on a real deployment. It is what decides whether this process
# writes 'production' or 'dev' into the usage log, and whether reserved-TLD email
# addresses are refused at signup. Override with PDFMINT_ORIGIN if you need to.
NODE_ENV=

# Billing. Without these the billing routes are inert and every account stays free.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Limits. The defaults are the numbers the public docs quote; a test fails if the
# two ever disagree, so change them in both places or not at all.
# MAX_CONCURRENT_RENDERS=2
# MAX_HTML_BYTES=10485760
# DEFAULT_TIMEOUT_MS=30000
# MAX_TIMEOUT_MS=120000
# RATE_LIMIT_PER_MINUTE=
# FILE_TTL_MINUTES=60

# Runs the asynchronous job worker in this process. One instance should have it.
JOBS_WORKER=1

# Lets a local test point a webhook at 127.0.0.1. Never set this in production:
# with it on, a caller-supplied URL becomes a server-side request forgery primitive.
# ALLOW_PRIVATE_NETWORK=
