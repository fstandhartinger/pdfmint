    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "playwright": "^1.50.1",
    "stripe": "^17.6.0"
  }
}
