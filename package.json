{
  "name": "pdfmint-api",
  "version": "1.0.0",
  "private": true,
  "description": "PDFMint - HTML/Markdown/URL to PDF API",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
